msgid "Связь с Гауди не настроена."
msgstr "Гауди менен байланыш жөндөлгөн эмес."

msgid "Гауди сейчас не отвечает. Попробуйте позже."
msgstr "Гауди азыр жооп бербей жатат. Кийинчерээк аракет кылыңыз."

msgid "Вас нет в Гауди. Обратитесь в учебный отдел."
msgstr "Сиз Гаудиде жоксуз. Окуу бөлүмүнө кайрылыңыз."

#, python-format
msgid "Гауди ответил ошибкой %(code)s."
msgstr "Гауди %(code)s катасы менен жооп берди."

msgid "Вход не завершён. Попробуйте ещё раз."
msgstr "Кирүү аяктаган жок. Кайра аракет кылыңыз."

#, python-format
msgid "Логин %(login)s не похож на ID в Гауди. Обратитесь в ИО."
msgstr "%(login)s логини Гаудидеги ID'ге окшобойт. Маалымат бөлүмүнө кайрылыңыз."

msgid "Русский"
msgstr "Орусча"

msgid "Кыргызча"
msgstr "Кыргызча"

msgid "English"
msgstr "Англисче"

msgid "Личный кабинет"
msgstr "Жеке кабинет"

msgid "Выйти"
msgstr "Чыгуу"

msgid "Студент"
msgstr "Студент"

#, python-format
msgid "%(course)s курс"
msgstr "%(course)s-курс"

msgid "Сотрудник"
msgstr "Кызматкер"

msgid "Вход"
msgstr "Кирүү"

msgid "Вход в личный кабинет"
msgstr "Жеке кабинетке кирүү"

msgid "Логин — ваш ID в университете, пароль — как в Moodle и Mattermost."
msgstr "Логин — университеттеги ID'ңиз, сырсөз — Moodle жана Mattermost'тогудай."

msgid "Я студент"
msgstr "Мен студентмин"

msgid "Я преподаватель / сотрудник"
msgstr "Мен окутуучумун / кызматкермин"

msgid "Вход ещё не настроен."
msgstr "Кирүү азырынча жөндөлгөн эмес."
