# Скопируйте в .env и заполните. Файл .env в git не попадает.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=cabinet.adam.edu.kg,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://cabinet.adam.edu.kg
# сайт за HAProxy (pfSense), который снимает HTTPS и ставит X-Forwarded-Proto
DJANGO_SECURE_COOKIES=1
DJANGO_BEHIND_HTTPS_PROXY=1

# Порт на ВМ, на который HAProxy передаёт запросы
CABINET_PORT=8102

DB_NAME=cabinet
DB_USER=cabinet
DB_PASSWORD=

# Keycloak: адрес realm и клиент кабинета. Пустой OIDC_STAFF_ISSUER — кнопки «Я преподаватель» нет.
OIDC_STUDENT_ISSUER=https://auth.adam.edu.kg/realms/student
OIDC_STUDENT_CLIENT_ID=cabinet
OIDC_STUDENT_CLIENT_SECRET=
OIDC_STAFF_ISSUER=
OIDC_STAFF_CLIENT_ID=cabinet
OIDC_STAFF_CLIENT_SECRET=

# Гауди: адрес и API-ключ с именем «cabinet»
GAUDI_API_URL=http://192.168.100.36:81
GAUDI_API_KEY=
API_TIMEOUT=5
